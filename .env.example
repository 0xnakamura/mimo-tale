# Xiaomi MiMo API (OpenAI-compatible)
# Get your key at https://platform.xiaomimimo.com
MIMO_API_KEY=sk-your-mimo-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Models — three pillars of MiMo V2.5
MIMO_REASONER_MODEL=mimo-v2.5-reasoner
MIMO_VISION_MODEL=mimo-v2.5-vision
MIMO_TTS_MODEL=mimo-v2.5-tts

# TTS voice id; see platform docs for the full catalogue
MIMO_TTS_VOICE=mimo-storyteller-warm

# Leave empty (or unset MIMO_API_KEY) to force mock mode — useful for
# local dev, demos, and grant reviewers without a key.
MIMO_FORCE_MOCK=
